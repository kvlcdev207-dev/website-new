# Environment variables
# Copy this file to `.env.local` and fill in the values as each phase needs them.
# Never commit real values — only this file (with empty values) is committed.

# The site's address (local or live) — needed from Phase 1
NEXT_PUBLIC_SITE_URL=

# Database connection string — Phase 2
MONGODB_URI=

# Login session secret — Phase 2 (the agent generates it)
AUTH_SECRET=

# Google login — Phase 2
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# The club's main email (super admin) — Phase 2
SUPER_ADMIN_EMAIL=

# Image storage — Phase 3
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Spam protection — Phase 5
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Contact form email — Phase 5
RESEND_API_KEY=
CONTACT_TO_EMAIL=
